{
  "name": "otheater-spike-tui-ink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Spike Fase 0: protótipo da TUI em Ink + @inkjs/ui (descartável)",
  "scripts": {
    "start": "tsx src/main.tsx",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.tsx --bundle --platform=node --format=esm --packages=external --outfile=dist/app.js && esbuild src/launcher.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
