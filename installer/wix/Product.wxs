<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MPL-2.0 -->
<!--
  The .msi of OTheater for Windows (Phase 10, P4). WiX 5 (`wix build`), see build.ps1, which passes the
  preprocessor variables below with `-d`.

  - Per user: no administrator, no UAC. Files in %LOCALAPPDATA%\Programs\OTheater, the registry in
    HKCU, and the PATH of the user (HKCU\Environment). The data folder (%LOCALAPPDATA%\OTheater) is
    not part of the package: install, repair, upgrade and uninstall never touch it.
  - One page of options (N322): a double click shows the choices of the install (the vault of the
    secrets, the logon service, the download of the ACP adapters) and an Install button; there is no
    wizard, no folder choice and no EULA page. A silent install (`/qn`) takes them as properties:
      VAULT              keep (default), keyring, encrypted-file or auto (`ot vault use`; keep writes nothing)
      LOGON_SERVICE      1 (default) or 0: `ot service install` (OtServiceInstall below)
      PREFETCH_ADAPTERS  all (default), claude-code, codex or 0 (N324): `ot adapters install <client>`
                         for claude-agent-acp, codex-acp or both, from npm; 1 is kept as all and an
                         empty value as 0, for the command lines of before [proposta]
    for example `msiexec /i otheater.msi /qn VAULT=encrypted-file PREFETCH_ADAPTERS=0`. A choice that
    needs an administrator is marked with the UAC shield and "needs administrator"; none of these does
    (the package is per user), so the page says so. The names and defaults are [proposta].
    The page is made of core elements (Dialog, Control, Publish): no WixUI extension. [proposta]
  - No WiX extension (so no `wix extension add`, which would download one): the custom actions are
    the core ones, and the .msi carries nothing of WiX besides the standard Windows Installer tables.
  - Unsigned (N247): SmartScreen warns on the first run.

  Variables (all paths absolute or relative to the working directory of `wix build`):
    Version           MSI ProductVersion, major.minor.build (build.ps1 derives it from the semver)
    SemVer            the full version (with the pre-release tag), recorded in HKCU\Software\OTheater
    OtExe             the single executable (Node SEA) of the P1; installed as ot.exe
    JobLauncher       ot-job-launcher.exe (P2); installed next to ot.exe, where the adapter looks first
    License           the LICENSE of the repository
    Notices           the third-party notices (installed as THIRD_PARTY_NOTICES.md)
    LauncherNotices   optional: the notices of the launcher (installed as THIRD_PARTY_NOTICES-job-launcher.md)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="OTheater"
    Manufacturer="OTheater"
    Version="$(Version)"
    UpgradeCode="b2692c03-b0c0-49ca-a331-9331c0eb0988"
    Scope="perUser"
    Compressed="yes"
    InstallerVersion="500"
  >
    <SummaryInformation Description="OTheater (Orchestration Theater)" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of OTheater is already installed. Remove it first to install this one."
    />
    <MediaTemplate EmbedCab="yes" />

    <!-- The choices of the install (N322). Secure: a silent install passes them to the execution. -->
    <Property Id="VAULT" Value="keep" Secure="yes" />
    <Property Id="LOGON_SERVICE" Value="1" Secure="yes" />
    <Property Id="PREFETCH_ADAPTERS" Value="all" Secure="yes" />
    <Launch
      Condition="Installed OR VAULT=&quot;keep&quot; OR VAULT=&quot;keyring&quot; OR VAULT=&quot;encrypted-file&quot; OR VAULT=&quot;auto&quot;"
      Message="VAULT=[VAULT]: use keep, keyring, encrypted-file or auto."
    />
    <Launch
      Condition="Installed OR NOT PREFETCH_ADAPTERS OR PREFETCH_ADAPTERS=&quot;all&quot; OR PREFETCH_ADAPTERS=&quot;claude-code&quot; OR PREFETCH_ADAPTERS=&quot;codex&quot; OR PREFETCH_ADAPTERS=&quot;0&quot; OR PREFETCH_ADAPTERS=&quot;1&quot;"
      Message="PREFETCH_ADAPTERS=[PREFETCH_ADAPTERS]: use all, claude-code, codex or 0."
    />
    <!-- The two boxes of the adapters on the page (see the UI below), checked from PREFETCH_ADAPTERS. -->
    <SetProperty
      Id="OtPrefetchClaude"
      Value="1"
      After="LaunchConditions"
      Sequence="ui"
      Condition="PREFETCH_ADAPTERS=&quot;all&quot; OR PREFETCH_ADAPTERS=&quot;1&quot; OR PREFETCH_ADAPTERS=&quot;claude-code&quot;"
    />
    <SetProperty
      Id="OtPrefetchCodex"
      Value="1"
      After="LaunchConditions"
      Sequence="ui"
      Condition="PREFETCH_ADAPTERS=&quot;all&quot; OR PREFETCH_ADAPTERS=&quot;1&quot; OR PREFETCH_ADAPTERS=&quot;codex&quot;"
    />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="OtProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OTheater">
          <!-- Made by the updates (the applier), not by this package: see OtUpdateLeftovers below. -->
          <Directory Id="OtPreviousDir" Name="previous" />
          <Directory Id="OtStagingDir" Name="staging" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="OTheater" Level="1">
      <ComponentGroupRef Id="OtFiles" />
    </Feature>

    <ComponentGroup Id="OtFiles">
      <!--
        A per-user component needs a registry key path (ICE38), and the folders it creates in the
        profile have to be removed on uninstall (ICE64): hence the RegistryValue with KeyPath and the
        RemoveFolder elements. The PATH entry is added at the end of the PATH of the user, and removed
        with the component. A component with files and a registry key path cannot have a generated
        GUID (WIX0230), so it has a fixed one: it never changes while the component keeps these files.
      -->
      <Component Id="OtBinaries" Directory="INSTALLFOLDER" Guid="8B82FA50-01FB-4C54-993B-11E0FA18D812">
        <File Id="OtExe" Name="ot.exe" Source="$(OtExe)" />
        <File Id="OtJobLauncher" Name="ot-job-launcher.exe" Source="$(JobLauncher)" />
        <File Id="OtLicense" Name="LICENSE" Source="$(License)" />
        <File Id="OtNotices" Name="THIRD_PARTY_NOTICES.md" Source="$(Notices)" />
        <?ifdef LauncherNotices ?>
        <File Id="OtLauncherNotices" Name="THIRD_PARTY_NOTICES-job-launcher.md" Source="$(LauncherNotices)" />
        <?endif?>
        <Environment Id="OtUserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="OtRemoveInstallFolder" On="uninstall" />
        <RegistryKey Root="HKCU" Key="Software\OTheater" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Version" Type="string" Value="$(SemVer)" KeyPath="yes" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>
      </Component>

      <!--
        What the updates leave beside ot.exe (N303; packages/daemon/src/updates/apply/layout.ts, journal.ts,
        trust.ts, main.ts): the journal and its temporary file, the log of the applier, the copy of the
        old executable, and the staged executable with its two proofs. Windows Installer removes only the
        files it installed, and a folder that is not empty is never removed (RemoveFolder), so without
        these the install folder would stay after an uninstall that came after an update. They are named
        one by one (the only pattern is the temporary journal, `update-state.json.<pid>.tmp`), so a file
        of the user in the folder stays, and the folder with it. Core WiX elements only: no extension.
        The folders `previous` and `staging` go before the install folder (RemoveFolders removes the
        deepest first). The same list is in installer/install.sh (remove_update_leftovers).
      -->
      <Component Id="OtUpdateLeftovers" Directory="INSTALLFOLDER" Guid="3C5F0E5A-6D0B-4B58-9E0D-6B7A0C2E41F7">
        <RemoveFile Id="OtRmJournal" Directory="INSTALLFOLDER" Name="update-state.json" On="uninstall" />
        <RemoveFile Id="OtRmJournalTemp" Directory="INSTALLFOLDER" Name="update-state.json.*.tmp" On="uninstall" />
        <RemoveFile Id="OtRmApplyLog" Directory="INSTALLFOLDER" Name="update-apply.log" On="uninstall" />
        <RemoveFile Id="OtRmPreviousExe" Directory="OtPreviousDir" Name="ot.exe" On="uninstall" />
        <RemoveFile Id="OtRmStagingExe" Directory="OtStagingDir" Name="ot.exe" On="uninstall" />
        <RemoveFile Id="OtRmStagingManifest" Directory="OtStagingDir" Name="manifest.json" On="uninstall" />
        <RemoveFile Id="OtRmStagingSignature" Directory="OtStagingDir" Name="manifest.json.sig" On="uninstall" />
        <RemoveFolder Id="OtRmPreviousDir" Directory="OtPreviousDir" On="uninstall" />
        <RemoveFolder Id="OtRmStagingDir" Directory="OtStagingDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\OTheater\Installer" Name="UpdateLeftovers" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- %LOCALAPPDATA%\Programs may not exist: it goes away on uninstall only if it is empty. -->
      <Component Id="OtProgramsFolder" Directory="OtProgramsDir">
        <RemoveFolder Id="OtRemoveProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\OTheater\Installer" Name="ProgramsFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      The logon service (P3). `ot service install` creates the Scheduled Task of the user; with
      the flag no-start the daemon is not started by the installer (it starts at the next logon, or when
      `ot tui` needs it). `ot service uninstall` stops the daemon the task started and removes the
      task; it never touches the data folder. The data folder is passed explicitly because the
      process of a custom action may not have the environment of the user. Both run as the user
      (Impersonate), never as SYSTEM, and neither fails the installation: without the service `ot tui`
      starts a daemon of its own, and an installation that cannot be removed would be worse. [proposta]
    -->
    <!--
      The vault and the adapters (N322) go before the service, so the daemon it starts later finds
      them. Same rules as the service: as the user, never failing the installation (a vault that
      cannot be written and a download that fails are said by `ot` in the log; both can be done
      later with `ot vault use` and `ot adapters install`).
    -->
    <CustomAction
      Id="OtVaultUse"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]ot.exe&quot; --data-dir &quot;[LocalAppDataFolder]OTheater&quot; vault use [VAULT]"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />
    <!-- One action per adapter (N324): a failed download of one does not keep the other. -->
    <CustomAction
      Id="OtAdaptersInstallClaude"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]ot.exe&quot; --data-dir &quot;[LocalAppDataFolder]OTheater&quot; adapters install claude-code"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />
    <CustomAction
      Id="OtAdaptersInstallCodex"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]ot.exe&quot; --data-dir &quot;[LocalAppDataFolder]OTheater&quot; adapters install codex"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />
    <CustomAction
      Id="OtServiceInstall"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]ot.exe&quot; --data-dir &quot;[LocalAppDataFolder]OTheater&quot; service install --no-start"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />
    <CustomAction
      Id="OtServiceUninstall"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]ot.exe&quot; --data-dir &quot;[LocalAppDataFolder]OTheater&quot; service uninstall"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
    />

    <InstallExecuteSequence>
      <!-- REMOVE="ALL" is also true for the old product in a major upgrade: its service goes first, the new one installs its own. -->
      <Custom Action="OtServiceUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="OtVaultUse" After="InstallFiles" Condition="NOT REMOVE AND VAULT AND VAULT&lt;&gt;&quot;keep&quot;" />
      <Custom Action="OtAdaptersInstallClaude" After="OtVaultUse" Condition="NOT REMOVE AND (PREFETCH_ADAPTERS=&quot;all&quot; OR PREFETCH_ADAPTERS=&quot;1&quot; OR PREFETCH_ADAPTERS=&quot;claude-code&quot;)" />
      <Custom Action="OtAdaptersInstallCodex" After="OtAdaptersInstallClaude" Condition="NOT REMOVE AND (PREFETCH_ADAPTERS=&quot;all&quot; OR PREFETCH_ADAPTERS=&quot;1&quot; OR PREFETCH_ADAPTERS=&quot;codex&quot;)" />
      <Custom Action="OtServiceInstall" After="OtAdaptersInstallCodex" Condition="NOT REMOVE AND LOGON_SERVICE AND LOGON_SERVICE&lt;&gt;&quot;0&quot;" />
    </InstallExecuteSequence>

    <!--
      The page of options (N322), a progress page and the three end pages, all core WiX. A check box
      sets its property to 1 when checked and clears it when not (hence the conditions above take an
      empty value or 0 as no). The texts are in English, like the rest of the package. [proposta]
      The two boxes of the adapters (N324) have private properties of the page: before the page,
      they are checked from PREFETCH_ADAPTERS (so `msiexec /i ... PREFETCH_ADAPTERS=codex` opens with
      only codex checked), and the Install button writes PREFETCH_ADAPTERS back from them.
      The Install button asks the shield of Windows (ElevationShield): Windows draws it only when
      the install needs elevation, which a per-user package does not.
    -->
    <UI>
      <TextStyle Id="OtNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="OtTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="OtNormal" />

      <RadioButtonGroup Property="VAULT">
        <RadioButton Value="keep" X="0" Y="0" Width="320" Height="15" Text="Keep what is configured (on a new install, the Windows Credential Manager)" />
        <RadioButton Value="keyring" X="0" Y="16" Width="320" Height="15" Text="The Windows Credential Manager" />
        <RadioButton Value="encrypted-file" X="0" Y="32" Width="320" Height="15" Text="An encrypted file in the data folder (asks a passphrase)" />
        <RadioButton Value="auto" X="0" Y="48" Width="320" Height="15" Text="Auto: the Credential Manager, or the file when it cannot be used" />
      </RadioButtonGroup>

      <Dialog Id="OtOptionsDlg" Width="370" Height="288" Title="[ProductName] [ProductVersion]">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\OtTitle}Install [ProductName] [ProductVersion]" />
        <Control Id="Where" Type="Text" X="20" Y="34" Width="330" Height="26" NoPrefix="yes" Text="For your user only, in [INSTALLFOLDER]. Your data folder (%LOCALAPPDATA%\OTheater) is never touched." />
        <Control Id="VaultLabel" Type="Text" X="20" Y="64" Width="330" Height="12" NoPrefix="yes" Text="Where to keep the secrets of the accounts:" />
        <Control Id="Vault" Type="RadioButtonGroup" Property="VAULT" X="28" Y="78" Width="322" Height="64" />
        <Control Id="Service" Type="CheckBox" Property="LOGON_SERVICE" CheckBoxValue="1" X="20" Y="148" Width="330" Height="16" Text="Start the OTheater daemon when I log on (a Scheduled Task of my user)" />
        <Control Id="PrefetchLabel" Type="Text" X="20" Y="168" Width="330" Height="12" NoPrefix="yes" Text="Download the ACP adapters now (from the npm registry; it needs the internet):" />
        <Control Id="PrefetchClaude" Type="CheckBox" Property="OtPrefetchClaude" CheckBoxValue="1" X="28" Y="182" Width="322" Height="15" Text="Claude Code (claude-agent-acp)" />
        <Control Id="PrefetchCodex" Type="CheckBox" Property="OtPrefetchCodex" CheckBoxValue="1" X="28" Y="198" Width="322" Height="15" Text="Codex (codex-acp)" />
        <Control Id="Elevation" Type="Text" X="20" Y="218" Width="330" Height="26" NoPrefix="yes" Text="None of these choices needs an administrator. A choice that did would show the shield of Windows and say &quot;needs administrator&quot;." />
        <Control Id="Line" Type="Line" X="0" Y="252" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="226" Y="261" Width="66" Height="17" Default="yes" ElevationShield="yes" Text="&amp;Install">
          <Publish Property="PREFETCH_ADAPTERS" Value="all" Order="1" Condition="OtPrefetchClaude AND OtPrefetchCodex" />
          <Publish Property="PREFETCH_ADAPTERS" Value="claude-code" Order="2" Condition="OtPrefetchClaude AND NOT OtPrefetchCodex" />
          <Publish Property="PREFETCH_ADAPTERS" Value="codex" Order="3" Condition="NOT OtPrefetchClaude AND OtPrefetchCodex" />
          <Publish Property="PREFETCH_ADAPTERS" Value="0" Order="4" Condition="NOT OtPrefetchClaude AND NOT OtPrefetchCodex" />
          <Publish Event="EndDialog" Value="Return" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="261" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="OtProgressDlg" Width="370" Height="130" Title="[ProductName] [ProductVersion]" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\OtTitle}Installing [ProductName]" />
        <Control Id="Action" Type="Text" X="20" Y="40" Width="330" Height="14" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="Progress" Type="ProgressBar" X="20" Y="58" Width="330" Height="12" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="76" Width="330" Height="14" NoPrefix="yes" Text="The download of the ACP adapters, when chosen, can take a minute." />
        <Control Id="Line" Type="Line" X="0" Y="96" Width="370" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="300" Y="104" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="OtExitDlg" Width="370" Height="130" Title="[ProductName] [ProductVersion]">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\OtTitle}[ProductName] [ProductVersion]" />
        <Control Id="Installed" Type="Text" X="20" Y="40" Width="330" Height="40" NoPrefix="yes" Hidden="yes" ShowCondition="NOT Installed" Text="Installed. Open a new terminal and type ot to start (the terminals open before the install do not have the new PATH yet)." />
        <Control Id="Changed" Type="Text" X="20" Y="40" Width="330" Height="40" NoPrefix="yes" Hidden="yes" ShowCondition="Installed" Text="Done." />
        <Control Id="Line" Type="Line" X="0" Y="96" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="300" Y="104" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="OtUserExitDlg" Width="370" Height="130" Title="[ProductName] [ProductVersion]">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\OtTitle}[ProductName] [ProductVersion]" />
        <Control Id="Text" Type="Text" X="20" Y="40" Width="330" Height="40" NoPrefix="yes" Text="Cancelled. Nothing was changed." />
        <Control Id="Line" Type="Line" X="0" Y="96" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="300" Y="104" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="OtFatalErrorDlg" Width="370" Height="130" Title="[ProductName] [ProductVersion]">
        <Control Id="Title" Type="Text" X="20" Y="12" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\OtTitle}[ProductName] [ProductVersion]" />
        <Control Id="Text" Type="Text" X="20" Y="40" Width="330" Height="40" NoPrefix="yes" Text="The installation failed and nothing was changed. msiexec /i with /l*v and a file name writes a log that says why." />
        <Control Id="Line" Type="Line" X="0" Y="96" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="300" Y="104" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="OtOptionsDlg" Before="OtProgressDlg" Condition="NOT Installed" />
        <Show Dialog="OtProgressDlg" Before="ExecuteAction" />
        <Show Dialog="OtExitDlg" OnExit="success" />
        <Show Dialog="OtUserExitDlg" OnExit="cancel" />
        <Show Dialog="OtFatalErrorDlg" OnExit="error" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="OtExitDlg" OnExit="success" />
        <Show Dialog="OtUserExitDlg" OnExit="cancel" />
        <Show Dialog="OtFatalErrorDlg" OnExit="error" />
      </AdminUISequence>
    </UI>
  </Package>
</Wix>
