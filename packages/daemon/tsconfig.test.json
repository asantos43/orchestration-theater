    { "path": "../protocol/tsconfig.src.json" },
    { "path": "../client/tsconfig.src.json" },
    { "path": "../sdk/tsconfig.src.json" },
    { "path": "../adapters/store-sqlite/tsconfig.src.json" },
    { "path": "../adapters/telemetry-sqlite/tsconfig.src.json" }
  ]
