{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-test",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
